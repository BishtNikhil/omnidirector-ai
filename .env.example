# OmniDirector AI — Environment Configuration
# ==========================================

# Meta Model API
META_MODEL_API_KEY=your_meta_model_api_key_here
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_NAME=muse-spark-1.1

# Baseten Inference (Muse Spark Open)
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# Modal Inference Endpoints
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Fireworks AI Inference
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Runtime Settings
OMNIDIRECTOR_PORT=8000
OMNIDIRECTOR_ENV=development
ENABLE_LOCAL_SIMULATION_FALLBACK=true
